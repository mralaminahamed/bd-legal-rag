# Bangladesh Legal RAG — environment template.
# Copy to `.env` and fill secrets. All keys are optional in development;
# defaults live in app/config.py. Prefix is BDRAG_.

# --- Service ---
BDRAG_ENVIRONMENT=development
BDRAG_LOG_LEVEL=INFO

# --- Datastores ---
BDRAG_DATABASE_DSN=postgresql+asyncpg://bdrag:bdrag@localhost:5432/bdrag
BDRAG_REDIS_DSN=redis://localhost:6379/0

# --- LLM Providers ---
# Default provider + per-provider model ids. Active provider/model can be
# overridden at runtime via the admin Settings page (FR-GN-3).
BDRAG_DEFAULT_PROVIDER=anthropic
BDRAG_ANTHROPIC_API_KEY=
BDRAG_OPENAI_API_KEY=
BDRAG_OLLAMA_BASE_URL=http://localhost:11434
BDRAG_ANTHROPIC_MODEL=claude-sonnet-4-6
BDRAG_OPENAI_MODEL=gpt-4o-mini
BDRAG_OLLAMA_MODEL=llama3.2

# --- Embedding (ADR-002) ---
# Cohere embed-multilingual-v3.0 at 1024 dims, stored as vector(1024) with
# HNSW cosine. The input_type asymmetry (search_document vs search_query) is
# enforced at the type level — never pass the wrong type.
BDRAG_COHERE_API_KEY=
BDRAG_EMBED_MODEL=embed-multilingual-v3.0
BDRAG_EMBED_DIMENSIONS=1024

# --- Reranker (ADR-003, FR-QR-5) ---
# rerank-multilingual-v3.0 is mandatory; reuses the Cohere API key above.
BDRAG_RERANK_MODEL=rerank-multilingual-v3.0

# --- Security ---
BDRAG_ADMIN_BEARER_TOKEN=
BDRAG_CORS_ORIGINS=["*"]
