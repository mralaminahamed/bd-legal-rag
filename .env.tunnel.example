# Values for `docker compose --env-file .env.tunnel -f docker-compose.prod.yml
# -f docker-compose.tunnel.yml`. Copy to .env.tunnel (git-ignored) and fill in.
# Generate each secret with: openssl rand -hex 32

DOMAIN=bd-legal-rag.alaminahamed.xyz
BDRAG_PORT=8101

POSTGRES_PASSWORD=
BDRAG_ADMIN_BEARER_TOKEN=

# The schema is halfvec(2560), which is qwen3-embedding:4b on Ollama. A Cohere
# embedding is 1024 wide and will not fit it, whatever the older comments say.
BDRAG_DEFAULT_PROVIDER=ollama
BDRAG_OLLAMA_BASE_URL=http://host.docker.internal:11434
BDRAG_OLLAMA_MODEL=gemma4:e2b-mlx
BDRAG_OLLAMA_EMBED_MODEL=qwen3-embedding:4b

# Only when the default provider is not ollama.
BDRAG_ANTHROPIC_API_KEY=
BDRAG_OPENAI_API_KEY=
BDRAG_COHERE_API_KEY=
