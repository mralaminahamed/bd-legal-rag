# BD Legal RAG — Caddy reverse proxy (NFR-PT-1).
# Author: Al Amin Ahamed.
#
# $DOMAIN is injected via the DOMAIN env var in docker-compose.prod.yml.
# Caddy provisions and renews Let's Encrypt TLS certificates automatically.
#
# Routing:
#   $DOMAIN/api/*   → FastAPI app (port 8000)
#   $DOMAIN/health  → FastAPI app (port 8000)
#   $DOMAIN/*       → Operator admin console / SPA (nginx, port 80)

{$DOMAIN} {
	encode zstd gzip

	# Security headers
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
	}

	# API and health check endpoints → FastAPI
	@api path /api/* /health
	handle @api {
		reverse_proxy app:8000
	}

	# All other paths → nginx-served admin console SPA
	handle {
		reverse_proxy web:80
	}
}
